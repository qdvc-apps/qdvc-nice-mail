[Desktop Entry]
Type=Application
Name=QDVC Nice Mail
GenericName=Email Writing Helper
Comment=Write emails faster with reusable emoji, phrases and signatures
Exec=@EXEC@ %U
Icon=qdvc.NiceMail
Terminal=false
Categories=Office;Email;
Keywords=email;mail;emoji;phrases;snippets;signature;note;eml;
StartupNotify=true
StartupWMClass=qdvc-nicemail
